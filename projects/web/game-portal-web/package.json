{
  "name": "game-portal-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4172 --strictPort",
    "build": "node scripts/build-pwa.mjs",
    "build:portal": "tsc -b && vite build",
    "build:embedded-games": "node scripts/build-embedded-games.mjs",
    "build:with-embedded": "npm run build",
    "build:cloudflare": "npm ci && npm --prefix ../random-shogi-web ci && npm --prefix ../yonmai-mahjong-web ci && npm run build:with-embedded",
    "preview": "vite preview --host 0.0.0.0 --port 4172 --strictPort",
    "preview:deploy": "vite preview --host 0.0.0.0 --port 4175 --strictPort",
    "deploy:check": "npm run build",
    "test:color-chain": "node scripts/test-color-chain.mjs",
    "test:portal-core": "node scripts/test-portal-core.mjs",
    "test:portal-phase2": "node scripts/test-portal-phase2.mjs",
    "test:portal-phase3": "node scripts/test-portal-phase3.mjs",
    "test:portal-phase4": "node scripts/test-portal-phase4.mjs",
    "test:portal-phase5": "node scripts/test-portal-phase5.mjs",
    "test:portal-phase6": "node scripts/test-portal-phase6.mjs",
    "test:portal-phase7": "node scripts/test-portal-phase7.mjs",
    "test:portal-phase8": "node scripts/test-portal-phase8.mjs",
    "test:portal-phase9": "node scripts/test-portal-phase9.mjs",
    "test:portal-phase10": "node scripts/test-portal-phase10.mjs",
    "test:portal-phase11": "node scripts/test-portal-phase11.mjs",
    "test:portal-phase12": "node scripts/test-portal-phase12.mjs",
    "test:portal-phase13": "node scripts/test-portal-phase13.mjs",
    "test:portal-phase14": "node scripts/test-portal-phase14.mjs",
    "test:portal-phase15": "node scripts/test-portal-phase15.mjs",
    "test:portal-phase16": "node scripts/test-portal-phase16.mjs",
    "test:portal-phase17": "node scripts/test-portal-phase17.mjs",
    "test:portal-phase18": "node scripts/test-portal-phase18.mjs",
    "test:portal-regression": "node scripts/test-portal-regression.mjs",
    "test:portal-browser": "node scripts/test-portal-browser.mjs",
    "test:color-chain-rotation": "node scripts/test-color-chain-rotation.mjs",
    "test:color-chain-map": "node scripts/test-color-chain-map.mjs",
    "icons:pwa": "node scripts/generate-pwa-icons.mjs",
    "seo:generate": "node scripts/generate-search-pages.mjs",
    "seo:sitemap": "node scripts/generate-search-pages.mjs --sitemap-only"
